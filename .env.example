# ============================================================
# Fruvia AI Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ============================================================

# ---------- App & Server ----------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0

# ---------- DINOv2 Feature Encoder ----------
DINOV2_MODEL_NAME=facebook/dinov2-base
DINOV2_REVISION=main

# ---------- Qdrant Cloud Vector Database ----------
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=fruvia_fruits360_original_dinov2_base_v1
QDRANT_TIMEOUT=10

# ---------- Candidate Search Behavior ----------
CLASS_SEARCH_CANDIDATE_MULTIPLIER=4
CLASS_SEARCH_MIN_CANDIDATES=30
CLASS_SEARCH_MAX_CANDIDATES=300

# ---------- Rate Limiting & Concurrency ----------
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_INFERENCES=4

# ---------- Upload & Pixel Limits ----------
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_WIDTH=5000
MAX_IMAGE_HEIGHT=5000

# ---------- CORS (Development Overrides) ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- Logging ----------
LOG_LEVEL=INFO

# ============================================================
# Fruvia AI Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ============================================================

# ---------- App & Server ----------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0

# Comma-separated allowed Host header values for TrustedHostMiddleware.
# In production, this must be explicitly configured without wildcards or 0.0.0.0.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,0.0.0.0

# ---------- DINOv2 Feature Encoder ----------
DINOV2_MODEL_NAME=facebook/dinov2-base
# In production, DINOV2_REVISION must be pinned to an exact 40-character hex commit SHA.
# Development may use 'main'.
DINOV2_REVISION=main
# HF_HOME=/path/to/custom/hf_cache

# ---------- Qdrant Cloud Vector Database ----------
QDRANT_URL=https://your-cluster.qdrant.io:6333

# Runtime API key: Used by FastAPI. In production, this should be READ-ONLY / collection-scoped.
QDRANT_API_KEY=your-runtime-read-only-qdrant-api-key

# Migration / Schema API key: Administrative key used ONLY by migration and payload indexing scripts.
QDRANT_MIGRATION_API_KEY=your-admin-migration-qdrant-api-key

# Default active collection for retrieval
QDRANT_COLLECTION=fruvia_fruits360_original_dinov2_base_v1

# Optional future unified gallery collection override (falls back to QDRANT_COLLECTION)
FRUVIA_GALLERY_COLLECTION=

# Collections verified to have 100% payload keyword index coverage for native Qdrant filtering
NATIVE_FILTER_SAFE_COLLECTIONS=fruvia_gallery_dinov2_base_v2

QDRANT_TIMEOUT=10

# ---------- Knowledge Subsystem (BGE-M3 Dense Retrieval) ----------
# Enable the semantic knowledge retrieval service (disabled by default to prevent model load overhead)
KNOWLEDGE_ENABLED=false
KNOWLEDGE_QDRANT_COLLECTION=fruvia_knowledge_bge_m3_v1
KNOWLEDGE_MODEL_NAME=BAAI/bge-m3
# In production with KNOWLEDGE_ENABLED=true, KNOWLEDGE_MODEL_REVISION must be pinned to a 40-character commit SHA.
KNOWLEDGE_MODEL_REVISION=main
KNOWLEDGE_VECTOR_SIZE=1024
KNOWLEDGE_MAX_TOP_K=20
KNOWLEDGE_MAX_QUERY_CHARS=2000
KNOWLEDGE_DEVICE=auto

# ---------- Candidate Search Behavior ----------
CLASS_SEARCH_CANDIDATE_MULTIPLIER=4
CLASS_SEARCH_MIN_CANDIDATES=30
CLASS_SEARCH_MAX_CANDIDATES=300

# Search quality thresholds
QUALITY_HIGH_THRESHOLD=0.80
QUALITY_MEDIUM_THRESHOLD=0.65

# ---------- Rate Limiting & Concurrency ----------
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_INFERENCES=4

# Reverse Proxy Trust (disabled by default to prevent IP spoofing)
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1,::1

# ---------- Upload & Request Body Limits ----------
MAX_UPLOAD_MB=10
# MAX_REQUEST_BODY_MB must be >= MAX_UPLOAD_MB to account for multipart overhead
MAX_REQUEST_BODY_MB=12
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_WIDTH=5000
MAX_IMAGE_HEIGHT=5000

# ---------- CORS & CSP ----------
# In production, CORS_ORIGINS must be explicitly configured and cannot contain wildcard '*'.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Content-Security-Policy settings & Allowed Image Hosts
# Comma-separated list of approved CDN / public R2 image hosts for CSP img-src and backend URL verification.
# Example: ALLOWED_IMAGE_HOSTS=pub-8ee1729b06674ae5b328c4d21021eac3.r2.dev,cdn.fruvia.ai
ENABLE_HSTS=false
ALLOWED_IMAGE_HOSTS=pub-8ee1729b06674ae5b328c4d21021eac3.r2.dev
CSP_CONNECT_ORIGINS=

# ---------- Logging ----------
LOG_LEVEL=INFO
